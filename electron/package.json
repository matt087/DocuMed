{
  "name": "documed",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "tsc && electron dist/main.js",
    "build": "tsc",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.documed.app",
    "productName": "DocuMed",
     "files": [
      "dist/**/*",
      "package.json",
      ".env"
    ],
    "extraResources": [
      {
        "from": "backend.zip",
        "to": "backend.zip"
      },
      {
        "from": "../frontend/dist/frontend/browser",
        "to": "frontend/browser",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "release"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "dotenv": "^17.4.2"
  }
}